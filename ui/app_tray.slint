// Full menu + reactive state, built against Slint 1.17.1 SystemTrayIcon.
export component AppTray inherits SystemTrayIcon {
    in-out property <image> tray_icon;
    in-out property <string> tray_tooltip: "smolvm 服务台";
    in-out property <string> list_kite_vm: "Kite VM — ?";
    in-out property <string> list_mcp_port: "MCP 入站端口 (8090) — ?";
    in-out property <string> list_mcp_loop: "MCP 循环 — ?";
    in-out property <string> list_cdp_port: "CDP 入站端口 (9222) — ?";
    in-out property <string> list_cdp_loop: "CDP 循环 — ?";
    in-out property <bool> can_open_cdp: false;
    in-out property <bool> can_open_mcp: false;
    in-out property <bool> can_restart_chromium: false;
    in-out property <bool> autostart_checked: false;
    in-out property <string> start_stop_label: "▶ 启动服务（确保在线）";
    in-out property <bool> start_stop_enabled: true;

    callback action-toggle();
    callback action-open-cdp();
    callback action-open-mcp();
    callback action-restart-chromium();
    callback action-open-logs();
    callback action-toggle-autostart();
    callback action-exit();
    callback tray-clicked();

    icon: root.tray_icon;
    tooltip: root.tray_tooltip;
    title: "smolvm 服务台";
    clicked => { root.tray-clicked(); }

    Menu {
        MenuItem { title: root.list_kite_vm; enabled: false; }
        MenuItem { title: root.list_mcp_port; enabled: false; }
        MenuItem { title: root.list_mcp_loop; enabled: false; }
        MenuItem { title: root.list_cdp_port; enabled: false; }
        MenuItem { title: root.list_cdp_loop; enabled: false; }
        MenuSeparator {}
        MenuItem { title: root.start_stop_label; enabled: root.start_stop_enabled; activated => { root.action-toggle(); } }
        MenuSeparator {}
        MenuItem { title: "打开 CDP 控制台 (9222)"; enabled: root.can_open_cdp; activated => { root.action-open-cdp(); } }
        MenuSeparator {}
        Menu { title: "高级（运维）";
            MenuItem { title: "打开 MCP 端点 (8090)"; enabled: root.can_open_mcp; activated => { root.action-open-mcp(); } }
            MenuItem { title: "重启 CDP 浏览器"; enabled: root.can_restart_chromium; activated => { root.action-restart-chromium(); } }
            MenuItem { title: "打开日志目录"; activated => { root.action-open-logs(); } }
        }
        MenuItem { title: "开机自动启动"; checked: root.autostart_checked; activated => { root.action-toggle-autostart(); } }
        MenuItem { title: "退出（不停止服务）"; activated => { root.action-exit(); } }
    }
}
